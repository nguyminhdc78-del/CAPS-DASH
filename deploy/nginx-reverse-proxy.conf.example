# Example nginx reverse proxy for the systemd deployment, where the app
# binds 127.0.0.1 only (see caps-dash.service) and nginx is the only thing
# that terminates TLS and faces the network. Copy into
# /etc/nginx/sites-available/, adjust the server_name and certificate
# paths, then symlink into sites-enabled.
#
# Two things here are load-bearing, not stylistic:
#
# 1. `Upgrade`/`Connection` headers on the /ws/ location - without them this
#    is a plain HTTP proxy and the WebSocket handshake never completes.
# 2. `proxy_read_timeout` set WELL above `WS_HEARTBEAT_S` (20s by default,
#    see .env.example). nginx closes an idle upstream connection after
#    `proxy_read_timeout` with no data; the app's own heartbeat is the only
#    traffic on a quiet camera stream, so a timeout shorter than - or too
#    close to - the heartbeat interval closes healthy connections. Also
#    `proxy_buffering off` on that location: buffering holds frames until a
#    buffer fills, so a live camera stream arrives in bursts instead of as
#    they are produced, or the socket looks silently stalled mid-stream.

server {
    listen 443 ssl http2;
    server_name parking.local;

    ssl_certificate     /etc/letsencrypt/live/parking.local/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parking.local/privkey.pem;

    client_max_body_size 2m;

    # --- WebSocket camera stream --------------------------------------
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WS_HEARTBEAT_S defaults to 20s; this is comfortably above it so an
        # idle-but-healthy stream is never mistaken for a dead one.
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;

        # Frames must reach the browser as the camera loop produces them,
        # not whenever nginx's buffer happens to fill.
        proxy_buffering off;
    }

    # --- REST API and the SPA ------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 30s;
    }
}

server {
    listen 80;
    server_name parking.local;
    return 301 https://$host$request_uri;
}

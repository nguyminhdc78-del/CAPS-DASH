# Production environment file for the systemd deployment.
# Copy to /etc/caps-dash/caps-dash.env (matches EnvironmentFile= in
# caps-dash.service), fill in the values below, then `chmod 600` it - it
# will hold the signing key. For the Docker deployment, copy this to `.env`
# next to docker-compose.yml instead; DATABASE_URL/BACKUP_DIR/SPA_DIST_DIR
# there are already fixed by the image's own ENV (see Dockerfile) and can be
# left out.
#
# Every key mirrors a field on Settings (backend/caps_dash/config/settings.py).
# `.env.example` at the repo root is the same contract for local development.

# --- Environment ---------------------------------------------------------
APP_ENV=prod
APP_NAME=CAPS-DASH
HOST=127.0.0.1
PORT=8000

# --- Security --------------------------------------------------------------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in prod while this is unset, the documented
# placeholder, or shorter than 32 bytes.
SECRET_KEY=
# REQUIRED. Comma-separated allowlist of the real dashboard origin(s). A
# wildcard or an empty list is rejected in prod.
CORS_ORIGINS=https://parking.local
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_S=300
# uvicorn's own env var - it decides whether request.client.host is the real
# caller or your reverse proxy. 127.0.0.1 is correct for the systemd unit's
# local nginx as shipped; under Docker set it to the bridge gateway address
# uvicorn actually sees, or every client collapses into one IP. "*" trusts
# every hop and makes X-Forwarded-For fully client-controlled - refused at
# startup when the public kiosk is on.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Storage ---------------------------------------------------------------
# Matches caps-dash.service's ReadWritePaths=/var/lib/caps-dash ...
DATABASE_URL=sqlite:////var/lib/caps-dash/caps.db
# ... and /var/backups/caps-dash.
BACKUP_DIR=/var/backups/caps-dash
RETENTION_MONTHS=6
BACKUP_KEEP_COUNT=5

# --- Vision pipeline ---------------------------------------------------------
DETECTOR_BACKEND=onnx
MODEL_PATH=/opt/caps-dash/models/yolo-vehicle.onnx
# How many inferences run AT ONCE. MUST stay 1 - one model in RAM, see
# settings.py. Not the same thing as INFERENCE_THREADS below, and not a knob
# for fitting a tick budget: raise the tick instead.
INFERENCE_POOL_SIZE=1
# Threads onnxruntime may use inside ONE inference. 0 = all cores. The cap was
# introduced to stop the detector starving the HEVC decoder an RTSP camera ran
# in the same process; the primary path now polls JPEG stills and runs no such
# decoder, so this is a plain resource bound. Measured on the 4-core board,
# 50 runs each: 2 threads 837ms, 3 threads 631ms, 4 threads 533ms per
# inference. 4 lets 3 cameras x 533ms fit a 2s tick; 2 threads did not.
# Match this to the host's core count.
INFERENCE_THREADS=4
INFERENCE_INPUT_SIZE=640
DETECTOR_CONFIDENCE=0.25
# Default for a NEW polled camera only; stored per camera, and a streaming
# source (rtsp, esp32cam_stream) is created at 0.2s because the poll interval
# is also the live view's frame rate. Left at 3.0 for a generic slow HTTP
# camera; the MaixCam runs at 2.0, set on its own row.
DEFAULT_POLL_INTERVAL_S=3.0
DEFAULT_VOTE_WINDOW=5
DEFAULT_VOTE_THRESHOLD=4
# Inference runs anyway this often even when nothing appears to change. The
# ceiling on how long the system may be wrong when the change gate misses a
# real change; raised from 10s when the tick went from 0.2s to 2s.
MOTION_FORCE_INTERVAL_S=30.0

# --- Plate reading (optional) ------------------------------------------------
# Reads the plate of a car when its bay fills, so a guard can find a car by
# its number (Find a car -> /plates, security and above; every search is
# audited). OFF by default: ~1s of the shared inference worker per arrival,
# models downloaded on first use, and it stores personal data. Purged on the
# same RETENTION_MONTHS schedule as history.
PLATE_READING_ENABLED=false
# Floor on the gap between detector runs, independent of the poll interval.
# 0 because it is inert at any tick >= 1.5s: it only gates change-triggered
# runs, whose spacing is already bounded by the tick. It existed for the 0.2s
# streaming tick, where 1.5 took the board from 3.54 load average to 0.83.
MIN_INFERENCE_INTERVAL_S=0.0
# Guards against a wedged camera, not a slow one - keep headroom over the
# worst case. CAMERA_FAIL_STREAK_OFFLINE already needs 3 failures in a row.
CAMERA_TIMEOUT_S=5.0
CAMERA_FAIL_STREAK_OFFLINE=3

# --- Public kiosk (optional) --------------------------------------------------
# Makes /kiosk reachable with no login and adds partial-match plate search to
# it. OFF by default: this is a real trade, not a formality - anyone on the
# network can locate any vehicle by typing part of its plate. Also needs
# PLATE_READING_ENABLED above, or there is nothing to search. FORWARDED_ALLOW_IPS
# must name the real reverse proxy or the per-IP budget below becomes one
# shared bucket for the whole building.
PUBLIC_KIOSK_ENABLED=false
PUBLIC_KIOSK_MAX_SEARCHES=10
PUBLIC_KIOSK_WINDOW_S=60

# --- Reporting & alerts --------------------------------------------------------
AGGREGATION_INTERVAL_S=600
MAX_EXPORT_ROWS=100000
OVERSTAY_HOURS=12.0
DISK_LOW_PERCENT=0.10
DISK_LOW_MIN_FREE_MB=256
ALERT_COOLDOWN_S=3600

# --- Realtime ----------------------------------------------------------------
WS_AUTH_DEADLINE_S=5.0
WS_HEARTBEAT_S=20.0
WS_MAX_VIEWERS_PER_CAMERA=4

# --- Web ---------------------------------------------------------------------
SPA_DIST_DIR=/opt/caps-dash/frontend/dist

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
# Unanchored: vitest writes to frontend/coverage, not just the repo root.
coverage/

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
# NOTE: lockfiles are deliberately COMMITTED for this project. Reproducible
# installs matter more here than a tidy diff: the deployment target is a
# single board, and "works on my machine" is not debuggable from a basement.
yarn.lock
pnpm-lock.yaml

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
plans/**/*
!plans/templates/*
screenshots/*
docs/screenshots/*
docs/research/*
logs.txt
test-ck
__pycache__

# CK meta commands
prompt.md
ck.md

# Gemini CLI settings (symlink to .claude/.mcp.json)
.gemini/settings.json
.claude/settings.bak.json

# chrome-devtools skill scratch output (screenshots, temp scripts, logs) -
# throwaway debug artifacts, never project deliverables
.claude/chrome-devtools/

# --- CAPS-DASH ---------------------------------------------------------------
# Python
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Runtime data. The database and its WAL sidecars are per-deployment state,
# never source. Keep the directory itself via data/.gitkeep.
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm

# Models. The exported .onnx IS committed (clone-and-run must work offline,
# which matters for competition demos and for flashing a board with no
# network). Training checkpoints and intermediate exports are not.
*.pt
*.pth
models/*.onnx.tmp

# Frontend
frontend/node_modules/
frontend/dist/
# Ops-only tooling (paramiko for board access); never part of the app.
.venv-ops/

# Firmware dumps contain the NVS partition, which stores WiFi credentials
# in plaintext. Never commit one - a private repo is still cloned and shared,
# and git history is forever.
firmware/backup/

# PlatformIO build output (firmware/esp32cam)
.pio/

# The hotspot password the ESP32-CAM joins with. The example header beside it
# IS committed - that one is the contract, this one is the secret. Kept out of
# the sketch itself because "fill it in, then remember to blank it before
# committing" is a process, and the cost of forgetting once is a live
# credential in git history forever.
firmware/esp32cam/wifi-credentials.h

# --- Not part of the product ------------------------------------------------
# Local AI coding-assistant configuration: skills, agents, hooks and prompts.
# It is developer tooling for whoever happens to be using it, not something a
# clone needs to build or run CAPS-DASH, and at ~2000 files it buried the 573
# that ARE the system. Kept on disk, out of the repo.
.claude/
.opencode/
.gemini/
CLAUDE.md
AGENTS.md

# Working documents (proposals, slide decks) and the lock/recovery files Word
# scatters beside them. Binary, unreviewable in a diff, and superseded the
# moment they are edited - they travel by email, not by git.
*.docx
*.pptx
~$*
~WRL*.tmp

# Loose image scratch - screenshots and sample stills kept while working on the
# vision pipeline. Nothing in the codebase references them.
image/

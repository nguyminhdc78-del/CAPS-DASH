# CAPS-DASH configuration.
# Copy to `.env` and adjust. `.env` is gitignored; this file is not.
# Every key mirrors a field on Settings (backend/caps_dash/config/settings.py).

# --- Environment -------------------------------------------------------------
APP_ENV=dev                      # dev | prod
APP_NAME=CAPS-DASH
HOST=0.0.0.0
PORT=8000

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to start with APP_ENV=prod while this is unset or a placeholder.
SECRET_KEY=change-me
# Comma-separated allowlist. A wildcard is rejected in prod.
# Leave empty in dev when the SPA is served from this same origin.
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# `Secure` flag on the refresh cookie. Unset = follow APP_ENV (Secure in prod,
# plain in dev) - correct when prod is HTTPS. Set to false ONLY when serving
# prod over plain http (e.g. a LAN demo board at http://<ip>:8000): a Secure
# cookie is dropped by the browser over http, so the session is lost on every
# reload. Relaxes cookie protection - use only on a trusted network.
# COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_S=300
# uvicorn's own env var - it decides whether request.client.host is the real
# caller or your reverse proxy. Leave at 127.0.0.1 for a local nginx; under
# Docker set it to the bridge gateway address uvicorn actually sees, or every
# client collapses into one IP. "*" trusts every hop and makes
# X-Forwarded-For fully client-controlled - refused in prod when the public
# kiosk is on.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/caps.db
BACKUP_DIR=./data/backups
# 6 months: the target host writes to flash with limited capacity and endurance.
RETENTION_MONTHS=6
BACKUP_KEEP_COUNT=5

# --- Vision pipeline ---------------------------------------------------------
DETECTOR_BACKEND=onnx            # onnx | ultralytics | fake
MODEL_PATH=./models/yolo-vehicle.onnx
# How many inferences run AT ONCE - not threads per inference, see below.
# One model in RAM; a correctness constraint, not a tuning knob.
INFERENCE_POOL_SIZE=1
# Threads onnxruntime may use inside ONE inference. 0 = all cores. The cap was
# introduced to stop the detector starving the HEVC decoder an RTSP camera ran
# in the same process; the primary path now polls JPEG stills and runs no such
# decoder, so this is a plain resource bound. Measured on the 4-core board,
# 50 runs each: 2 threads 837ms, 3 threads 631ms, 4 threads 533ms per
# inference. 4 lets 3 cameras x 533ms fit a 2s tick; 2 threads did not.
# Match this to the host's core count.
INFERENCE_THREADS=4
INFERENCE_INPUT_SIZE=640         # lower (e.g. 416) trades accuracy for CPU
DETECTOR_CONFIDENCE=0.25
# Poll interval x vote threshold decides how long a slot takes to flip state.
# Note this is only the default for a NEW polled camera: it is stored per
# camera, and a streaming source (rtsp, esp32cam_stream) is created at 0.2s
# instead, because the poll interval is also the live view's frame rate.
# Left at 3.0 for a generic slow HTTP camera; the MaixCam runs at 2.0, set on
# its own row rather than by retuning this default for one device.
DEFAULT_POLL_INTERVAL_S=3.0      # 3.0 x 4 votes is about 12s to settle
DEFAULT_VOTE_WINDOW=5
DEFAULT_VOTE_THRESHOLD=4
# Inference runs anyway this often even when nothing appears to change, so
# slow drift (dusk, auto-exposure) cannot keep the detector asleep. This is
# the ceiling on how long the system may be wrong when the change gate misses
# a real change - a deliberate trade for headroom, raised from 10s when the
# tick went from 0.2s to 2s.
MOTION_FORCE_INTERVAL_S=30.0

# --- Plate reading (optional) ------------------------------------------------
# Reads the plate of a car when its bay fills, so a guard can find a car by
# its number. OFF by default, deliberately: it costs ~1s of the shared
# inference worker per arrival (measured on the board), it downloads its
# models on first use, and it stores a plate number - which identifies a
# vehicle and through it a person. Switch it on only if you have decided to
# store that.
# Plate rows are purged on the same RETENTION_MONTHS schedule as history.
PLATE_READING_ENABLED=false
# Floor on the gap between detector runs, independent of the poll interval.
# 0 because it is inert at any tick >= 1.5s: it only gates change-triggered
# runs, whose spacing is already bounded by the tick. It existed for the 0.2s
# streaming tick (where 1.5 took the board from 3.54 load average to 0.83) and
# remains a lever for any future fast source.
MIN_INFERENCE_INTERVAL_S=0.0
# Guards against a wedged camera, not a slow one - keep headroom over the
# worst case. CAMERA_FAIL_STREAK_OFFLINE already needs 3 failures in a row.
CAMERA_TIMEOUT_S=5.0
CAMERA_FAIL_STREAK_OFFLINE=3

# --- Public kiosk (optional) --------------------------------------------------
# Makes /kiosk reachable with no login and adds partial-match plate search to
# it. OFF by default: this is a real trade, not a formality - anyone on the
# network can locate any vehicle by typing part of its plate. Also needs
# PLATE_READING_ENABLED above, or there is nothing to search. FORWARDED_ALLOW_IPS
# must name the real reverse proxy or the per-IP budget below becomes one
# shared bucket for the whole building.
PUBLIC_KIOSK_ENABLED=false
PUBLIC_KIOSK_MAX_SEARCHES=10
PUBLIC_KIOSK_WINDOW_S=60

# --- Reporting & alerts --------------------------------------------------------
AGGREGATION_INTERVAL_S=600
MAX_EXPORT_ROWS=100000
OVERSTAY_HOURS=12.0
DISK_LOW_PERCENT=0.10
DISK_LOW_MIN_FREE_MB=256
ALERT_COOLDOWN_S=3600

# --- Realtime ----------------------------------------------------------------
WS_AUTH_DEADLINE_S=5.0
WS_HEARTBEAT_S=20.0
WS_MAX_VIEWERS_PER_CAMERA=4

# --- Web ---------------------------------------------------------------------
SPA_DIST_DIR=./frontend/dist

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true                    # false gives a colourised console renderer
